<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    A frozen Orchard Core 3 site running the released module from nuget.org. It writes the "before" database
    for the upgrade check, so it deliberately does NOT follow the repository's Orchard version.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A frozen, loopback-only test site on old packages by design; their advisories are not actionable here. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OrchardCore.Application.Cms.Targets" Version="3.0.1" />
    <PackageReference Include="IgniteSG.OrchardCore.MspMarketingEdge" Version="1.7.2" />
    <Compile Include="../Shared/**/*.cs" LinkBase="Shared" />
    <Content Include="../VerifyEditorial/Recipes/**/*.json" Link="Recipes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
