<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Orchard Core 3 and the released module are on nuget.org; the preview feed mapping must not apply here. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
