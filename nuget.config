<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Orchard Core 4 is consumed as one exact preview build, which is only published to Orchard's
    preview feed. Map the Orchard package names to that feed so they are never resolved from
    another source; translations and every other dependency come from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="orchard-preview" value="https://nuget.cloudsmith.io/orchardcore/preview/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="orchard-preview">
      <package pattern="OrchardCore.*" />
      <package pattern="OrchardCore" />
      <package pattern="SafeMode" />
      <package pattern="TheAdmin" />
      <package pattern="TheAgencyTheme" />
      <package pattern="TheBlogTheme" />
      <package pattern="TheComingSoonTheme" />
      <package pattern="TheTheme" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="OrchardCore.Translations.*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
