<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>IgniteSG.OrchardCore.MspMarketingEdge</PackageId>
    <Authors>Ignite Solutions Group</Authors>
    <Description>Orchard Core module for MSP Marketing Edge blog syndication</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Ignite-Solutions-Group/ignite-autoblog</RepositoryUrl>
    <PackageTags>orchardcore;module;msp;autoblog;marketing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Exact versions on purpose. Orchard Core 4 is still a preview whose nightly builds can change API, and
    this module is only verified against the one build named in Directory.Build.props. A host on a different
    nightly gets a restore conflict instead of a silent mismatch.
  -->
  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="OrchardCore.ContentManagement" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="OrchardCore.BackgroundTasks" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="OrchardCore.Media.Abstractions" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="OrchardCore.Email.Abstractions" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="OrchardCore.Seo" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="OrchardCore.PublishLater" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="OrchardCore.ContentFields" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="OrchardCore.Title" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="OrchardCore.Html" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="OrchardCore.Autoroute" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="OrchardCore.Lists" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" Version="[$(OrchardCoreVersion)]" />
    <PackageReference Include="OrchardCore.Settings.Core" Version="[$(OrchardCoreVersion)]" />
  </ItemGroup>

  <ItemGroup>
	<None Include="..\..\README.md" Pack="true" PackAs="content" PackagePath="\" />
  </ItemGroup>

</Project>
